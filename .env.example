# 数据管理接口鉴权(请求头 Authorization: Bearer <token>)
# 留空时管理接口不可用;生产环境务必使用强随机值,例如:
#   openssl rand -hex 32
ADMIN_TOKEN=change-me-to-a-long-random-token

# 公开视图审核过滤:设为 1 后,所有公开接口(/api/graph、/api/search 等)
# 只返回 reviewStatus=reviewed 的内容(草稿/驳回不可见)。
# 默认关闭(开发环境可见全部)。上线前请逐条审核并置 reviewed 后开启。
# PUBLIC_REVIEWED_ONLY=1
