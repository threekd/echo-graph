[Unit]
Description=Echo Graph (FastAPI + React)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=echograph
Group=echograph
WorkingDirectory=/opt/echo-graph
EnvironmentFile=/opt/echo-graph/.env
ExecStart=/home/echograph/.local/bin/uv run --frozen uvicorn app.main:app --host 127.0.0.1 --port 8000 --workers 2
Restart=always
RestartSec=3
NoNewPrivileges=true

[Install]
WantedBy=multi-user.target
