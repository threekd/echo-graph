# 引导管理员邮箱:该邮箱注册时自动获得 admin 角色(首个管理员引导机制)。
# 公共星云/官方图谱概念已移除(2026-08-28):admin 的星云与其他用户星云
# 数据语义完全一致,不再作为默认视图;启动时若该邮箱已注册则自动补角色。
# 管理接口(/api/admin/*)只接受 admin 角色登录态,不再使用 ADMIN_TOKEN。
ADMIN_BOOTSTRAP_EMAIL=

# 写接口限流可信代理(逗号分隔的 IP/CIDR):仅当连接来自这些地址时才解析
# X-Forwarded-For(从右向左跳过可信代理段取客户端 IP);直连 uvicorn 或伪造
# 请求头时一律使用对端地址。默认信任本机回环。
# 应用于注册/登录与关注等使用 app/ratelimit.py 的接口。
TRUSTED_PROXIES=127.0.0.1,::1

# 账号体系(邮箱+密码注册/登录,httpOnly Cookie 会话)
# Cloudflare Turnstile 人机验证:在 Cloudflare Dashboard 创建 Site 后得到两把密钥。
# 生产环境必须配置 SECRET:未配置时注册默认失败(fail-closed);
# 仅本地开发可设 TURNSTILE_ALLOW_SKIP=1 临时跳过(请勿在生产设置)。
TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=
TURNSTILE_ALLOW_SKIP=0

# HTTPS 部署时设为 1,会话 Cookie 仅经安全连接传输;本地 http 开发保持 0。
COOKIE_SECURE=0

# ============================================================
# 邮件服务(邮箱验证 / 忘记密码重置)
# ============================================================
# 发送器模式:api = 阿里云邮件推送 DirectMail(推荐);smtp = 标准 SMTP;
# 留空或 log = 仅本地开发(不真正发信)。生产必须配置 api 或 smtp。
MAILER=

# 站外邮件链接使用的外部地址(如 https://litnebula.com),邮件里的验证/重置
# 深链以此为基础;不配置时回退 http://localhost:8000(生产务必配置)。
SITE_BASE_URL=

# 注册后是否强制邮箱验证:1 = 新注册需点击邮件验证链接才能登录(引导管理员
# 也在验证通过后才获得 admin 角色);0 = 关闭(旧行为,注册即登录)。
# 设为 1 时必须先配置好 MAILER,否则注册将 fail-closed 全部失败。
EMAIL_VERIFY_REQUIRED=0

# 游客落地星云(可选):填某用户的「用户名」。游客打开首页时自动进入该公开星云
# (相当于给游客一个固定的展示星云);用户名只作为服务端配置,不出现在 URL/界面,
# 避免暴露可用作登录的账号标识。未配置或目标星云不可用(未公开/已禁用)时,
# 游客仍见空图 + 登录提示。登录用户始终进入自己的星云,不受此配置影响。
LANDING_SPACE=

# AI 书籍导入的上传临时目录(可选):缺省为 <项目>/data/imports(服务账号可写)。
# 若服务器把数据盘挂在别处,可设为如 /var/lib/echo-graph/imports(须可写)。
# IMPORT_DIR=

# ---- 阿里云邮件推送 DirectMail(MAILER=api)----
# 在阿里云控制台开通「邮件推送」并配置发信域名/发信地址后,创建 AccessKey
# (RAM 用户最小授权 AliyunDirectMailFullAccess),填写以下三项:
# ALIYUN_DM_ACCESS_KEY_ID / ALIYUN_DM_ACCESS_KEY_SECRET / ALIYUN_DM_ACCOUNT_NAME。
# 注意:ACCOUNT_NAME 填控制台创建的「发信地址」(如 no-reply@你的域名),
# 不是控制台默认的随机账号(形如 xxx@<uid>.onaliyun.com)。
ALIYUN_DM_ACCESS_KEY_ID=
ALIYUN_DM_ACCESS_KEY_SECRET=
ALIYUN_DM_ACCOUNT_NAME=
# 区域:cn-hangzhou(中国大陆,发信域名需 ICP 备案)/ ap-southeast-1(新加坡,
# 适合海外 VPS,无备案要求)。发信域名/发信地址按区域隔离,此值必须与创建
# 发信地址的控制台区域一致,否则报 InvalidMailAddress.NotFound。
# 可选覆盖 ALIYUN_DM_ENDPOINT。
ALIYUN_DM_REGION=cn-hangzhou
ALIYUN_DM_ENDPOINT=
# 回信地址策略:控制台已配置回信地址时保持 true(默认);未配置时改为 false,
# 否则 SingleSendMail 会返回 InvalidReplyAddress 错误。
ALIYUN_DM_REPLY_TO=true

# ---- SMTP 备用通道(MAILER=smtp)----
# SMTP_TLS=1 走 587 STARTTLS;留空走 465 SSL。SMTP_FROM 缺省用 SMTP_USER。
SMTP_HOST=
SMTP_PORT=
SMTP_USER=
SMTP_PASS=
SMTP_FROM=
SMTP_TLS=0

# ============================================================
# AI 录入管线(agent_temp/tools/*)专用,仅运行书籍解析/去重 CLI 时需要
# ============================================================
# DeepSeek 书籍解析 LLM(agent_temp/tools/extract_source_book.py)
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=
DEEPSEEK_MODEL=deepseek-v4-flash
DEEPSEEK_THINKING=0

# 阿里云百炼 Embedding 语义去重(agent_temp/tools/dedupe_check.py;
# 未配置时自动降级为基础匹配)
ALIYUN_API_KEY=
ALIYUN_BASE_URL=
ALIYUN_MODEL=text-embedding-v4
