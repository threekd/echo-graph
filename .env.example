# 引导管理员邮箱:该邮箱注册时自动获得 admin 角色,并把尚未归属的历史数据
# 认领为管理员空间(公共星云)。启动时若该邮箱已注册则自动补角色并认领。
# 数据管理接口(/api/admin/*)只接受 admin 角色登录态,不再使用 ADMIN_TOKEN。
ADMIN_BOOTSTRAP_EMAIL=

# 公开视图审核过滤:设为 1 后,所有公开接口(/api/graph、/api/search 等)
# 只返回 reviewStatus=reviewed 的内容(草稿/驳回不可见)。
# 生产环境建议开启;需先逐条审核数据并置 reviewed。
PUBLIC_REVIEWED_ONLY=0

# 写接口限流可信代理(逗号分隔的 IP/CIDR):仅当连接来自这些地址时才解析
# X-Forwarded-For;直连 uvicorn 时伪造请求头无效。默认信任本机回环。
# 应用于注册/登录与关注等使用 app/ratelimit.py 的接口。
TRUSTED_PROXIES=127.0.0.1,::1

# 账号体系(邮箱+密码注册/登录,httpOnly Cookie 会话)
# Cloudflare Turnstile 人机验证:在 Cloudflare Dashboard 创建 Site 后得到两把密钥。
# 未配置 SECRET 时注册接口跳过人机验证(仅限本地开发,生产务必配置)。
TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# HTTPS 部署时设为 1,会话 Cookie 仅经安全连接传输;本地 http 开发保持 0。
COOKIE_SECURE=0

# ============================================================
# AI 录入管线(agent_temp/tools/*)专用,仅运行书籍解析/去重 CLI 时需要
# ============================================================
# DeepSeek 书籍解析 LLM(agent_temp/tools/extract_source_book.py)
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=
DEEPSEEK_MODEL=deepseek-v4-flash
DEEPSEEK_THINKING=0

# 阿里云百炼 Embedding 语义去重(agent_temp/tools/dedupe_check.py;
# 未配置时自动降级为基础匹配)
ALIYUN_API_KEY=
ALIYUN_BASE_URL=
ALIYUN_MODEL=text-embedding-v4
