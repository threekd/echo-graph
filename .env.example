# Neo4j 图数据库配置
# 获取 API 密钥:https://neo4j.com/cloud/aura/
NEO4J_URI=neo4j+s://<host>.databases.neo4j.io
NEO4J_USERNAME=neo4j
NEO4J_PASSWORD=your-password
NEO4J_DATABASE=neo4j

# 数据管理接口鉴权(请求头 Authorization: Bearer <token>)
# 留空时管理接口不可用;生产环境务必使用强随机值
ADMIN_TOKEN=change-me-to-a-long-random-token

# 可选:强制使用 JSON 内存兜底(不连 Neo4j),取值 json
# ECHO_STORE=json
